#!/usr/bin/env python3
"""A `git` for tests: records each call, then behaves as the test asked."""
import json
import os
import sys
import time

arguments = sys.argv[1:]
log = os.environ.get("FAKE_GIT_LOG")
if log:
    with open(log, "a", encoding="utf-8") as stream:
        json.dump({"arguments": arguments, "environment": dict(os.environ)}, stream)
        stream.write("\n")

command = "clone" if arguments[0] == "clone" else "rev-list"
time.sleep(float(os.environ.get("FAKE_GIT_SECONDS", "0")))
exit_code = int(os.environ.get(f"FAKE_GIT_{command.upper().replace('-', '_')}_EXIT", "0"))
if exit_code:
    print(f"fatal: {command} went wrong", file=sys.stderr)
    sys.exit(exit_code)
if command == "rev-list":
    # One list per repository is not needed: the clone URL only names what is checked.
    print("\n".join(os.environ.get("FAKE_GIT_COMMITS", "").split()))
